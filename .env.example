# Copy this to .env and fill in your Supabase project values.
# Never commit .env — it is git-ignored (SEC-4).

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Service role key — used ONLY by scripts/seed.ts (server-side).
# NEVER put this in src/ or client-side code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── Optional feature flags (src/lib/featureFlags.ts) ────────────────────────
# Every enhancement below is OFF unless its value is exactly "true".
# With all of them unset, the app behaves exactly as it always has: the manual
# search -> photo -> check-in flow, no new queries and no new UI. Flip one on
# to test that feature against the same build and the same database.
# Restart `npm run dev` after changing these — Vite reads env at startup.

# NOTE: there is no VITE_FEATURE_QR. QR pass scanning is always on — it is core
# guard workflow, and because Vite inlines these at BUILD time while this file's
# real counterpart is git-ignored, the flag was permanently false in every
# deployed build. See the comment atop src/pages/Guard/ScanPass.tsx.

VITE_FEATURE_OCR=false                   # on-device PaddleOCR; requires public/models/ocr/ weights
VITE_FEATURE_FACE_VERIFY=false           # not built yet
VITE_FEATURE_AI_RECOMMENDATION=false     # not built yet
VITE_FEATURE_DEVICE_REG=false            # not built yet
VITE_ID_REDACTION=false                  # MUST be true before scanning any real visitor's ID — see PRODUCTION-GOTCHAS.md GOTCHA-2
